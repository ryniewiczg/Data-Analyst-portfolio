      <aliases enabled='yes' />
      <column caption='Timely response' datatype='integer' name='[Calculation_1440954433425408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Timely response?]=&apos;Yes&apos; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Timely res%' datatype='real' name='[Calculation_1440954434527233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1440954433425408])/sum([Number of Records])' />
      </column>
      <column caption='In progress' datatype='integer' name='[Calculation_1440954435866626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Company response to consumer]=&apos;In progress&apos; THEN [Number of Records] end' />
      </column>
      <column caption='In progress %' datatype='real' name='[Calculation_1440954436296707]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1440954435866626])/sum([Number of Records])' />
      </column>
      <column caption='Trend Dynamic Calc' datatype='datetime' name='[Calculation_2301047472340992]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 1], [Date received])' />
      </column>
      <column caption='Trend color' datatype='string' name='[Calculation_2301047501639681]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;WHEN &quot;Daily&quot; THEN &quot;Daily&quot;&#13;&#10;WHEN &quot;Weekly&quot; THEN &quot;Weekly&quot;&#13;&#10;WHEN &quot;Monthly&quot; THEN &quot;Monthly&quot;&#13;&#10;WHEN &quot;Quarterly&quot; THEN &quot;Quarterly&quot;&#13;&#10;WHEN &quot;Yearly&quot; THEN &quot;Yearly&quot;&#13;&#10;END' />
      </column>
