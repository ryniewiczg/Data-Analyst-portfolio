      <column caption='Accident Severity' datatype='string' name='[Accident_Severity]' role='dimension' type='nominal' />
      <column caption='PY Accidents ' datatype='integer' name='[CY Accidents (copy)_1801594697342979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if Year([Accident Date])=[Parameters].[Current Year (copy)_1801594696220673] then [Index] end)' />
      </column>
      <column caption='CY casualties' datatype='integer' name='[CY Accidents (copy)_1801594700001285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if Year([Accident Date])=[Parameters].[Parameter 1] then [Number_of_Casualties] end)' />
      </column>
      <column caption='CY Serious casualties' datatype='integer' name='[CY Fatal casualties (copy)_1801594704650251]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if Year([Accident Date])=[Parameters].[Parameter 1] and [Accident_Severity]=&apos;Serious&apos; then [Number_of_Casualties] end)' />
      </column>
      <column caption='CY Slight casualties' datatype='integer' name='[CY Serious casualties (copy)_1801594705461262]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if Year([Accident Date])=[Parameters].[Parameter 1] and [Accident_Severity]=&apos;Slight&apos; then [Number_of_Casualties] end)' />
      </column>
      <column caption='CY Fatal casualties' datatype='integer' name='[CY casualties (copy)_1801594702053384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(if Year([Accident Date])=[Parameters].[Parameter 1] and [Accident_Severity]=&apos;Fatal&apos; then [Number_of_Casualties] end)' />
      </column>
      <column aggregation='Sum' caption='Year' datatype='integer' name='[Calculation_1801594695311360]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Accident Date])' />
      </column>
      <column caption='CY Accidents' datatype='integer' name='[Calculation_1801594696470530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if Year([Accident Date])=[Parameters].[Parameter 1] then [Index] end)' />
      </column>
      <column caption='YoY Accidents' datatype='real' default-format='*↑0.00%;↓0.00%' name='[Calculation_1801594697527300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1801594696470530]-[CY Accidents (copy)_1801594697342979])/[CY Accidents (copy)_1801594697342979]' />
